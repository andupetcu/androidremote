<?xml version="1.0" encoding="utf-8"?>
<!--
    Backup rules for Android 11 and below (fullBackupContent).
    Nothing is backed up (AM-15): enrollment data identifies this device to the MDM server and
    must never be restored onto another device. The manifest also sets allowBackup="false".
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
