<?xml version="1.0" encoding="utf-8"?>
<!--
    Release network security policy: HTTPS only (AM-06 / AR-17).

    A <domain> entry matches a host NAME (or one exact IP literal). It cannot express a subnet,
    so the previous "192.168.0.0 / 192.168.1.0 / 192.168.68.0" entries never matched any device
    and only gave a false impression of a LAN allow-list. They are removed.

    Default: no cleartext anywhere. Deployments should serve the MDM server over HTTPS.

    If a LAN deployment must use plain HTTP, list the exact server host name (or exact IP) below,
    one <domain> per server, in the build-time list of cleartext hosts for the release build, e.g.
        <domain-config cleartextTrafficPermitted="true">
            <domain includeSubdomains="false">mdm.lan</domain>
        </domain-config>
    Never list a whole range, and never enable cleartext in base-config.

    Debug builds use app/src/debug/res/xml/network_security_config.xml, which permits cleartext
    so the emulator (10.0.2.2) and LAN test servers keep working.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
